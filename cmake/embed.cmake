# embed_file(<input> <symbol> <output.c>)
# Generates a C file containing:  const unsigned char <symbol>[]; const unsigned int <symbol>_size;
function(embed_file INPUT SYMBOL OUTPUT)
  if(EXISTS ${OUTPUT} AND ${OUTPUT} IS_NEWER_THAN ${INPUT})
    return()
  endif()
  message(STATUS "Embedding ${INPUT} -> ${SYMBOL}")
  file(READ ${INPUT} HEX HEX)
  string(LENGTH "${HEX}" HEXLEN)
  math(EXPR SIZE "${HEXLEN} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BODY "${HEX}")
  string(REGEX REPLACE "((0x..,){32})" "\\1\n" BODY "${BODY}")
  file(WRITE ${OUTPUT} "/* generated by embed.cmake - do not edit */\n")
  file(APPEND ${OUTPUT} "const unsigned char ${SYMBOL}[] = {\n${BODY}\n};\n")
  file(APPEND ${OUTPUT} "const unsigned int ${SYMBOL}_size = ${SIZE};\n")
endfunction()
